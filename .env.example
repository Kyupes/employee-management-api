# Application
PORT=3000
NODE_ENV=development

# PostgreSQL connection used by the application
# Docker Compose overrides DB_HOST with the database service name.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_a_database_password
DB_NAME=employee_management

# Connection string used by node-pg-migrate from the host machine
DATABASE_URL=postgres://postgres:replace_with_a_database_password@localhost:5432/employee_management

# Authentication
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h
SALT_ROUNDS=10

# Redis
# Keep REDIS_PASSWORD and the password embedded in REDIS_URL identical.
# Use the host name "redis" with Docker Compose and "localhost" when the API runs on the host.
REDIS_PASSWORD=replace_with_a_redis_password
REDIS_URL=redis://:replace_with_a_redis_password@redis:6379
